# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Timezone used to compute "today" on dashboards
APP_TIMEZONE=Asia/Kolkata

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_voucher
DB_USER=postgres
DB_PASSWORD=postgres
# Optional: full connection string (overrides the values above), e.g. for Neon / Render
# DATABASE_URL=postgres://user:password@host:5432/expense_voucher
# DB_SSL=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Signature uploads (images are stored in PostgreSQL)
MAX_FILE_SIZE_MB=2
